# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# The product whose public posts you search, and your own company (its employees are skipped)
PRODUCT=Slack
OWN_COMPANY=Slack
SINCE_DAYS=30

# The prospect that needs a reference (used to rank matches)
PROSPECT_INDUSTRY=Software Development
PROSPECT_SIZE=201-500

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
